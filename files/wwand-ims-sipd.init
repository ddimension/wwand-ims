#!/bin/sh /etc/rc.common
# sipd: SIP for LAN phones over the modem's IMS (wwand-ims)

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode -L /usr/share/wwand-ims /usr/share/wwand-ims/sipd.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_set_param file /etc/config/wwand_ims
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger wwand_ims
}
