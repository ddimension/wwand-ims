#!/bin/sh /etc/rc.common
# sipd: SIP for LAN phones or a PBX trunk over IMS (wwand-ims). With
# `config ims_modem` / `option backend 'ue'` the router's own IMS UE is the
# line. One instance per ims_modem section — one IMS line per modem
# (sipd/lines.uc derives what each uses); without a section one instance
# with the defaults.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/share/wwand-ims/sipd.uc

start_line() {
	local section="$1"

	procd_open_instance "$section"
	procd_set_param command /usr/bin/ucode -L /usr/share/wwand-ims -L '/usr/lib/ucode/*.so' \
		"$PROG" --line "$section"
	# the UE retries its registration itself; a crash is restarted for ever,
	# and so is the orderly end for a new SIM in the modem
	procd_set_param respawn 300 10 0
	# SIGTERM: the UE de-REGISTERs and removes its SAs before it exits
	procd_set_param term_timeout 10
	procd_set_param stderr 1
	procd_set_param file /etc/config/wwand_ims
	procd_close_instance
	LINES=$((LINES + 1))
}

start_service() {
	LINES=0
	config_load wwand_ims
	config_foreach start_line ims_modem
	[ "$LINES" -gt 0 ] && return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode -L /usr/share/wwand-ims -L '/usr/lib/ucode/*.so' "$PROG"
	procd_set_param respawn 300 10 0
	procd_set_param term_timeout 10
	procd_set_param stderr 1
	procd_set_param file /etc/config/wwand_ims
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger wwand_ims
}
