#!/bin/sh
# /etc/hotplug.d/iface/25-wwand-ims-l3mdev
# The kernel installs the l3mdev FIB rules (pref 1000, v4 and v6) only once
# per network namespace, when the first VRF appears. netifd flushes the
# policy rules on every restart, and nothing brings them back: sockets bound
# to the IMS VRF then route only through netifd's `from <addr>` rules
# (wwand docs/vrf.md). Re-add them on any ifup while a VRF exists.
#
# ifupdate as well: wwand renews a connection IN PLACE (a redial after its own
# restart, a reconnect inside the hold) and netifd then reports the new
# address as ifupdate, never as ifup. Handled on ifup only, the new /32 kept
# netifd's unicast host route and the old one its `local` — bind() answered
# "Address not available" until someone ran ifup (HW, RG650E/Chateau,
# 2026-11-16, twice).
case "$ACTION" in ifup|ifupdate) ;; *) exit 0 ;; esac
ip link show type vrf 2>/dev/null | grep -q . || exit 0
for f in -4 -6; do
	ip $f rule show pref 1000 | grep -q l3mdev ||
		ip $f rule add pref 1000 l3mdev protocol kernel
done

# Restore VRF-local delivery for the cellular /32 the UE binds to.
#
# When an IPv4 /32 address sits on a VRF slave, netifd adds a
# `<addr> dev <slave> proto static scope link` host route into the VRF table.
# In a VRF the kernel keeps the *local* delivery route in that same table, so
# netifd's unicast host route displaces it. The symptom is nasty and silent:
# the address is no longer recognised as local, so bind() to it fails (unless
# net.ipv4.ip_nonlocal_bind=1) and, worse, inbound packets to it are matched
# as unicast-to-forward and dropped at the IP layer before UDP — tcpdump shows
# them on the wire and even on the VRF master, but no socket ever receives them
# and no counter moves. The IMS UE (router-as-UE) hits exactly this: the REGISTER
# egresses, the P-CSCF's 401 comes back on the wire, and the UE times out
# "unprotected". HW-proven on the GDSP IoT SIM (2026-11-15), RG650E/Chateau.
# IPv6 is unaffected (netifd adds no such host route for a /128).
#
# Re-assert `local <addr>` for every global IPv4 address on each VRF slave.
# Idempotent (route replace), dynamic-safe (reads the current address), and it
# removes the need for the ip_nonlocal_bind / udp_l3mdev_accept crutches.
for vrf in $(ip -o link show type vrf 2>/dev/null | sed 's/^[0-9]*: \([^:@]*\).*/\1/'); do
	tbl=$(ip -d link show "$vrf" 2>/dev/null | sed -n 's/.*vrf table \([0-9]*\).*/\1/p')
	[ -n "$tbl" ] || continue
	for dev in $(ip -o link show master "$vrf" 2>/dev/null | sed 's/^[0-9]*: \([^:@]*\).*/\1/'); do
		addrs=$(ip -4 -o addr show dev "$dev" scope global 2>/dev/null | while read -r _ _ _ cidr _; do
			echo "${cidr%/*}"
		done)
		for a in $addrs; do
			ip route replace local "$a" dev "$dev" table "$tbl" 2>/dev/null
		done
		# ...and drop the `local` of an address that left the device: the
		# kernel removes its own, but not the one replaced in here, and a
		# packet for the previous /32 would still be delivered locally
		ip -4 route show table "$tbl" type local dev "$dev" 2>/dev/null | while read -r _ a _; do
			case " $(echo $addrs) " in *" $a "*) ;; *) ip route del local "$a" dev "$dev" table "$tbl" 2>/dev/null ;; esac
		done
	done
done
