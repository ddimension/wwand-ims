# /etc/config/wwand_ims — example
#
# IMS operator settings live here, NOT in /etc/config/network: a profile is
# a property of the operator (and of the SIM that selects it), not of one
# modem or interface, and several modems may share it.

# --- operator profiles --------------------------------------------------
# Selected per SIM: the longest matching match_imsi / match_iccid prefix
# wins (ims_modem `profile` 'auto'; a name there picks that profile). Values
# marked [modem] are applied to the modem; values marked [mbn] can only be
# carried by the modem's carrier configuration (MBN) and are written there
# by the MBN tooling, or checked against it when a vendor MBN is used.
# Values marked [ue] are what the router's own IMS UE (backend 'ue') acts
# on; without a matching profile it runs on its built-in defaults (T1 500 ms,
# T2 4 s, the network's choice of expiry, every algorithm it supports).

config ims_profile 'vodafone_iot'
	option label		'Vodafone Global IoT (GDSP, IMSI 90128)'
	list   match_imsi	'90128'
	list   match_iccid	'8988239'
	# [modem] the IMS PDN: the modem's IMS profile (profile 2 on the RG650E)
	option ims_apn		'ims.iot'
	option ims_pdp_type	'ipv4v6'
	# [modem] 3GPP TS 24.301 voice domain preference and UE usage setting
	option voice_domain	'ps_preferred'	# cs_only|ps_only|cs_preferred|ps_preferred
	option usage		'data_centric'	# data_centric|voice_centric
	option sms_domain	'ps'		# ps (SMS over IP first)|cs
	# [modem] IMS, VoLTE, SMS over IMS on
	option ims		'1'
	option volte		'1'
	option sms_over_ims	'1'
	# [mbn] carrier MBN: 'auto' = the modem's own choice, a name = select it,
	# 'patch' = build the values below into mbn_base and load the result
	# under mbn_name
	option mbn		'patch'
	option mbn_base		'ROW_Commercial'
	option mbn_name		'Commercial-Vodafone-GDSP-VoLTE'
	# [mbn] IMS settings (Vodafone IoT 90128 Variant Settings, c-IoT column)
	option pcscf		'pco'
	option domain		'auto'		# from the IMSI: ims.mnc028.mcc901.3gppnetwork.org
	option auth		'akav1-md5'	# [ue] the only one it speaks
	# [ue] the sec-agree offer: hmac-sha-1-96, hmac-md5-96 / null, aes, 3des
	option ipsec_integrity	'hmac-sha-1-96'
	list   ipsec_encryption	'null'
	list   ipsec_encryption	'aes'
	# [ue] without tcp the UE does not listen on TCP (its own requests
	# always go out over UDP)
	option sip_transport	'udp,tcp'
	option sip_mtu		'1430'
	option sip_t1_ms	'2000'		# [ue]
	option sip_t2_s		'16'		# [ue]
	option sip_t4_s		'17'
	option reg_expires	'3600'		# [ue] asked for; the network decides
	option session_expires	'1800'
	option preconditions	'1'
	option early_media	'1'
	# [ue] subscribe to the registration state (RFC 3680): the network
	# ending or shortening the registration is noticed at once
	option reg_event	'1'
	# [ue] more of the UE's behaviour, all optional:
	# option user_agent	'wwand-ims'	# the User-Agent header
	# option pcscf_port	'5060'		# where the first REGISTER goes
	# option rtp_timeout_s	'30'		# end a call when a side sends no
	#					#   RTP for that long; 0 = never
	# option rtcp_timeout_s	'0'		# the same for RTCP; 0 = off
	# option alert_delay_ms	'4500'		# an incoming call: our 180 Ringing
	#					#   that late (the LAN phone rings at
	#					#   once), so a phone on another SIM of
	#					#   the number is alerted too; 0 = at
	#					#   once. Telekom cancels a leg without
	#					#   18x after 5.9 s: stay below that
	# [ue] SMS over IP (with ims_modem option smsip): the SMS centre, else
	# the one an SMS came from, else the SIM's (AT+CSCA?); and the URI the
	# SMS go to, %s for the SC's number (default: tel:<SC>)
	# option sms_smsc	'+491234567890'
	# option sms_psi	'sip:%s@ims.example.net;user=phone'
	option ut		'0'
	option emergency	'ims'
	list   codec		'amr-wb'
	list   codec		'amr'

# --- modems ---------------------------------------------------------------
config ims_modem
	option modem		'wwmodem0'	# wwand_modem section in /etc/config/network
	option profile		'auto'		# auto = by SIM, or a profile name
	option audio		'auto'		# auto|uac|pcm_tty (backend qmi)
	# backend 'ue': the router is the IMS UE (sipd/line_ue.uc). It needs the
	# IMS PDN as a wwand interface in its own VRF (files/ims-network.example)
	# and, on a Quectel data module, the LTE FGI override (FGI 3 and 7). The
	# default 'qmi' bridges to the modem's own IMS through the ims plugin.
	option backend		'ue'
	option ims_iface	'wwims'		# the IMS PDN's netifd interface
	option vrf		'ims'		# its VRF device
	# option ims_apn	'ims'		# picks the CGCONTRDP line for the P-CSCF
	# fixed P-CSCF instead of what the PDN names (a list: the next one is
	# tried when one does not answer, as with the PDN's own list)
	# option pcscf		'2001:db8::5'
	# SMS over IP (backend 'ue', TS 24.341): the UE registers for SMS, what
	# arrives is written into the modem's store as if the modem had received
	# it (wwandctl sms <modem> ME, the LuCI SMS list) and wwand's
	# modem_sms_send goes out over IMS. With one number on several SIMs the
	# network may then send the SMS to the router instead of the phone. A
	# full store is reported to the network, which delivers again later.
	# Off by default.
	# option smsip		'1'
	# option sms_storage	'ME'		# ME (modem memory) or SM (SIM)
	# VoWiFi (package wwand-ims-vowifi): the UE's IMS through an IKEv2
	# tunnel to the operator's ePDG instead of the IMS PDN (ims_iface)
	# option access		'vowifi'	# pdn (default) | vowifi
	# option epdg		'epdg.epc.mnc001.mcc262.pub.3gppnetwork.org'
	# option vowifi_vrf	'imswifi'	# the tunnel's VRF, table 31
	# option vowifi_table	'31'
	# option rtp_base	'40000'		# relay ports, both sides; the IMS
	# option rtp_span	'200'		#   zone's RTP rule must cover them

# --- the SIP side ---------------------------------------------------------
config sip_gateway 'main'
	option listen		'lan'		# a network interface, or an address
	option port		'5060'
	option realm		'wwand-ims'
	# the codecs of backend qmi (sipd answers with them itself). Backend ue
	# relays the SDP: the phone or PBX must offer AMR-WB or AMR (Asterisk:
	# codec_amr, allow=amrwb,amr), sipd passes them 1:1 to the network
	list   codec		'g722'
	list   codec		'pcma'
	list   codec		'pcmu'
	# debugging: every SIP message (LAN and IMS side) in full into a file.
	# It holds identities and keys; leave it off in normal operation
	#option sip_trace	'/tmp/wwand-ims-sip.trace'
	# the last ten calls (ubus call wwand-ims calls, Status -> VoLTE): in
	# RAM by default; a file on flash keeps them over a reboot, one write
	# per call
	#option call_history	'/var/run/wwand-ims-sipd.calls'

# a phone or a PBX trunk (it registers here; files/asterisk-pjsip.example)
config extension
	option username		'asterisk'
	option password		'change-me'
	option modem		'wwmodem0'
	option caller_id	'1'
